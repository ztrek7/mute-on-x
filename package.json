{
  "name": "mute-on-x",
  "private": true,
  "license": "MIT",
  "description": "Local development tools for the Mute on X browser extension",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tests/cache.cjs && node tests/fixture.cjs",
    "test:native": "xvfb-run -a node tests/fixture.cjs --native-menu",
    "package": "python3 scripts/package.py",
    "verify:package": "python3 scripts/package.py --check"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
